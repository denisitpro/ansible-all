#!/usr/bin/env bash
# GitHub organizations backup script
# Generated by Ansible - DO NOT EDIT MANUALLY
# Managed by github-backup role

set -euo pipefail

SCRIPT_NAME="github-backup"
WORK_DIR="{{ github_backup_work_dir }}"
LOG_DIR="{{ github_backup_log_dir }}"
LOG_FILE="${LOG_DIR}/${SCRIPT_NAME}-$(date +%Y%m%d-%H%M%S).log"
LOCK_FILE="/tmp/${SCRIPT_NAME}.lock"
RAGE_RECIPIENT="{{ github_backup_rage_recipient }}"
RCLONE_TARGET="{{ github_backup_rclone_target }}"
REMOTE_PATH="{{ github_backup_remote_path }}"

SELECTED_ORGS=()
SELECTED_COUNT=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --org) SELECTED_ORGS+=("$2"); (( SELECTED_COUNT++ )) || true; shift 2 ;;
        *) echo "Unknown argument: $1" >&2; exit 1 ;;
    esac
done

log() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] $*" | tee -a "${LOG_FILE}"
}

cleanup() {
    rm -f "${LOCK_FILE}"
    rm -rf "${WORK_DIR}/clone"
}

trap cleanup EXIT

should_backup_org() {
    local org="$1"
    [ "${SELECTED_COUNT}" -eq 0 ] && return 0
    local s
    for s in "${SELECTED_ORGS[@]}"; do
        [ "$s" = "$org" ] && return 0
    done
    return 1
}

if [ -f "${LOCK_FILE}" ]; then
    log "ERROR: Another instance is already running"
    exit 1
fi
touch "${LOCK_FILE}"

mkdir -p "${WORK_DIR}/clone" "${WORK_DIR}/encrypted"

fetch_org_repos() {
    local org="$1"
    local token="$2"
    GH_TOKEN="${token}" gh repo list "${org}" --limit 4000 --json nameWithOwner -q '.[].nameWithOwner'
}

backup_repo() {
    local full_name="$1"
    local token="$2"
    local immediate_upload="${3:-false}"
    local org="${full_name%%/*}"
    local repo="${full_name##*/}"
    local date_tag
    date_tag=$(date +%Y%m%d)
    local clone_dir="${WORK_DIR}/clone/${org}/${repo}"
    local encrypted_dir="${WORK_DIR}/encrypted/${org}/${repo}"
    local encrypted_file="${encrypted_dir}/${repo}__${date_tag}.tar.gz.age"

    mkdir -p "${encrypted_dir}" "${WORK_DIR}/clone/${org}"

    log "  Cloning ${full_name} (depth={{ github_backup_clone_depth }})"
    if ! git clone --quiet --depth="{{ github_backup_clone_depth }}" \
        "https://x-access-token:${token}@github.com/${full_name}.git" \
        "${clone_dir}" 2>>"${LOG_FILE}"; then
        log "  ERROR: failed to clone ${full_name}"
        rm -rf "${clone_dir}"
        return 1
    fi

    log "  Encrypting ${full_name}"
    tar -czf - -C "${WORK_DIR}/clone/${org}" "${repo}" \
        | rage -r "${RAGE_RECIPIENT}" -o "${encrypted_file}"

    local size
    size=$(du -sh "${encrypted_file}" | cut -f1)
    log "  OK: ${org}/${repo}/${repo}__${date_tag}.tar.gz.age (${size})"

    if [ "${immediate_upload}" = "true" ]; then
        rm -rf "${clone_dir}"
        rclone copy "${encrypted_dir}" \
            "${RCLONE_TARGET}:${REMOTE_PATH}/${org}/${repo}" \
            --transfers="{{ github_backup_rclone_transfers }}" \
            --checkers="{{ github_backup_rclone_checkers }}" \
            --fast-list \
            --log-file="${LOG_FILE}" \
            --log-level INFO
        rm -rf "${encrypted_dir}"
    fi
}

backup_org_full() {
    local org="$1"
    local date_tag
    date_tag=$(date +%Y%m%d)
    local full_encrypted_dir="${WORK_DIR}/encrypted/full-backup/${org}"
    local full_encrypted_file="${full_encrypted_dir}/${org}__${date_tag}.tar.gz.age"

    mkdir -p "${full_encrypted_dir}"

    log "  Creating full org archive for ${org}"
    tar -czf - -C "${WORK_DIR}/clone" "${org}" \
        | rage -r "${RAGE_RECIPIENT}" -o "${full_encrypted_file}"

    rm -rf "${WORK_DIR}/clone/${org}"

    local size
    size=$(du -sh "${full_encrypted_file}" | cut -f1)
    log "  OK full: full-backup/${org}/${org}__${date_tag}.tar.gz.age (${size})"
}

log "=== GitHub backup started (filter: ${SELECTED_ORGS[*]:-all}) ==="

ERRORS=0
declare -A PROCESSED

{% for org in github_backup_orgs %}
if should_backup_org "{{ org.name }}"; then
    log "--- Org: {{ org.name }} ---"
    repo_count_{{ loop.index }}=0
    while IFS= read -r full_name; do
        [ -z "${full_name}" ] && continue
        PROCESSED["${full_name}"]=1
        repo_count_{{ loop.index }}=$(( repo_count_{{ loop.index }} + 1 ))
        backup_repo "${full_name}" "{{ org.token }}" "{{ 'true' if not (org.full_backup | default(true)) else 'false' }}" || (( ERRORS++ )) || true
    done < <(fetch_org_repos "{{ org.name }}" "{{ org.token }}")
    log "  Processed ${repo_count_{{ loop.index }}} repos in {{ org.name }}"
    {% if org.full_backup | default(true) %}
    backup_org_full "{{ org.name }}" || (( ERRORS++ )) || true
    {% endif %}
fi
{% endfor %}

{% for item in github_backup_extra_repos %}
if should_backup_org "{{ item.repo.split('/')[0] }}" && [ -z "${PROCESSED[{{ item.repo | string | replace('"', '') | tojson }}]+set}" ]; then
    log "--- Extra repo: {{ item.repo }} ---"
    backup_repo "{{ item.repo }}" "{{ item.token }}" || (( ERRORS++ )) || true
fi
{% endfor %}

log "--- Uploading to ${RCLONE_TARGET}:${REMOTE_PATH} ---"
rclone copy "${WORK_DIR}/encrypted" \
    "${RCLONE_TARGET}:${REMOTE_PATH}" \
    --transfers="{{ github_backup_rclone_transfers }}" \
    --checkers="{{ github_backup_rclone_checkers }}" \
    --fast-list \
    --log-file="${LOG_FILE}" \
    --log-level INFO

rm -rf "${WORK_DIR}/encrypted"

log "=== GitHub backup completed with ${ERRORS} error(s) ==="
[ "${ERRORS}" -eq 0 ] || exit 1
