{% if loki_nginx_alert_504_enabled | default(false) %}
  - alert: NginxIngressHigh504Rate
    expr: |
      sum by ({{ loki_nginx_alert_504_group_by | default(loki_nginx_alert_group_by | default('app')) }}) (
        count_over_time(
          {{ loki_nginx_alert_504_selector | default(loki_nginx_alert_selector | default('{app!=""}')) }}
          {{ loki_nginx_alert_504_filter | default(
              '|~ "\\\"container_name\\\":\\\"' ~ (loki_nginx_alert_container_name_regex | default('(nginx|angie)')) ~ '\\\""'
              ~ ' |= " 504 "'
          ) }}
          [{{ loki_nginx_alert_504_window | default('10m') }}]
        )
      ) > {{ loki_nginx_alert_504_threshold | default(100) }}
    for: {{ loki_nginx_alert_504_for | default('2m') }}
    labels:
      severity: critical
      instance: "{{ '{{' }} $labels.hostname {{ '}}' }}"
    annotations:
      summary: "High rate of HTTP 504 from nginx"
      description: "More than {{ loki_nginx_alert_504_threshold | default(100) }} HTTP 504 responses in {{ loki_nginx_alert_504_window | default('10m') }}"
{% endif %}
