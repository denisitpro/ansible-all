# {{ ansible_managed }}
# sender-api's own Valkey: a disposable cache (sender-api falls back to live notixy-api reads).
# Password-protected: no network perimeter is trusted.
bind {{ sender_api_valkey_bind }}
port {{ sender_api_valkey_port }}
protected-mode yes
requirepass {{ sender_api_valkey_password }}
save ""
appendonly no
maxmemory {{ sender_api_valkey_maxmemory }}
maxmemory-policy allkeys-lru
