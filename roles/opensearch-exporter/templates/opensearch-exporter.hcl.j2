{{ ansible_managed | comment }}
service {
  name = "{{ consul_opensearch_exporter_name }}"
  port = {{ opensearch_exporter_bind_port }}
  tags = [
{% for tag in consul_opensearch_exporter_tags %}
    "{{ tag }}",
{% endfor %}
  ]

{% if consul_opensearch_exporter_token is defined %}
  token = "{{ consul_opensearch_exporter_token }}"
{% endif %}

  check = {
    id       = "opensearch-exporter-check"
    name     = "OpenSearch Exporter Health Check"
    tcp      = "localhost:{{ opensearch_exporter_bind_port }}"
    interval = "10s"
    timeout  = "2s"
  }
}
