# {{ ansible_managed }}
# Kora runtime config for Sigma9 wallet — Solana Devnet (LOCAL, gitignored).
# Phase-0 live verification config. Adds a mock 6-dec token we control the mint of
# (4CW8GB…, price-sourced via Mock as a generic mint = 0.001 SOL) so the relayer
# mechanics can be proven end-to-end without the browser-only Circle USDC faucet.
# Real devnet USDC (4zMMC9…) stays allow-listed for the on-device product run.

[kora]
rate_limit = 100

[kora.enabled_methods]
liveness = true
estimate_transaction_fee = true
get_supported_tokens = true
get_payer_signer = true
sign_transaction = true
sign_and_send_transaction = true
transfer_transaction = false
get_blockhash = true
get_config = true

# Per-wallet usage cap. In PAID pricing mode (we use [validation.price] type="fixed",
# a paid model, NOT Free) kora derives the limiter key ON-CHAIN from the owner/authority
# of the token account paying our fee — so it is NOT client-spoofable (Free mode instead
# trusts a caller-supplied user_id). This caps how many sponsored txs one paying wallet
# can push per window, closing the "spam the relayer" hole alongside the fee-payer policy.
# In-memory store (no cache_url) → counters are per-process and reset on restart; for
# persistent / multi-instance enforcement point cache_url at Redis. Tune max/window_seconds.
[kora.usage_limit]
enabled = true
# cache_url = "redis://127.0.0.1:6379"   # uncomment for shared/persistent counters
fallback_if_unavailable = false           # deny if the store is unreachable (Redis only)

[[kora.usage_limit.rules]]
type = "transaction"
max = 100
window_seconds = 3600

[validation]
max_allowed_lamports = 10000000
max_signatures = 10
price_source = "Mock"
# price_source = "Jupiter"


allow_durable_transactions = false
cross_cluster_check = false


# All 5 base programs + both CCTP v2 IDs are the SAME address on devnet and mainnet-beta,
# so this list is cluster-agnostic (only the token mints below differ per cluster).
allowed_programs = [
    "11111111111111111111111111111111",              # System Program                  (all clusters)
    "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA",   # SPL Token Program                (all clusters)
    "ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL",  # Associated Token Account Program (all clusters)
    "ComputeBudget111111111111111111111111111111",   # Compute Budget                   (all clusters)
    "AddressLookupTab1e1111111111111111111111111",   # Address Lookup Table (if used)   (all clusters)
    # CCTP v2 — required for the gasless sol→EVM burn (issue #145). Same IDs devnet + mainnet.
    "CCTPV2vPZJS2u2BBsUoscuikbYjnpFmbFsvVuJdgUMQe",  # CCTP v2 TokenMessengerMinterV2 (depositForBurn)
    "CCTPV2Sm4AdWt5296sk4P66VBZ7bEhcARwFaaS9YPbeC",  # CCTP v2 MessageTransmitterV2  (CPI target of the burn)
]

# Token mints are PER-CLUSTER — pick the set for the cluster this relayer serves:
#   DEVNET  USDC = 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU  (6 dec)
#   MAINNET USDC = EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v  (6 dec)
allowed_tokens = [
    "4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU",  # DEVNET USDC (swap for mainnet mint in prod)
]

allowed_spl_paid_tokens = [
    "4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU",  # DEVNET USDC (swap for mainnet mint in prod)
]


disallowed_accounts = []

# Token-2022 extension blocklist — HARD reject if the fee-payment token's mint carries a
# dangerous extension. permanent_delegate lets a third party move/burn tokens from ANY
# account of that mint; we never accept such a mint as a paid fee token. Our allowed USDC
# (devnet 4zMMC9…, mainnet EPjFWdd5…) is a CLASSIC SPL token (Tokenkeg, no extensions), so
# this is a no-op guard today — it only bites if a Token-2022 mint is ever allow-listed.
# Key MUST be `token_2022` WITH the underscore (kora's root-example `token2022` form is
# silently ignored). transfer_hook is the other candidate to add here later.
[validation.token_2022]
blocked_mint_extensions = ["permanent_delegate"]
blocked_account_extensions = []   # required field even if empty (kora rejects the section without it)

[validation.fee_payer_policy.system]
# allow_transfer OFF: the fee-payer is never the SOL sender in our flows (plain SPL
# transfer, lazy ATA creation, CCTP v2 burn all have the USER as sender/authority; the
# fee-payer only pays network fee + account rent). Verified against kora v2.2 source —
# this flag gates System Transfer only when the fee-payer is the source — so turning it
# off closes the "force the fee-payer to send SOL without paying" hole without breaking
# those flows. Turn back on only if a future flow needs the fee-payer itself to move SOL.
allow_transfer = false
allow_assign = false
allow_create_account = true   # required: ATA rent + CCTP MessageSent account creation
allow_allocate = true         # kept on (CCTP path unverified); candidate to disable after a devnet dry-run

[validation.fee_payer_policy.spl_token]
allow_transfer = true
allow_burn = true # allow burn for gasless
allow_close_account = true
allow_approve = false
allow_revoke = false
allow_set_authority = false
allow_mint_to = false
allow_initialize_mint = false
allow_initialize_account = true
allow_initialize_multisig = false
allow_freeze_account = false
allow_thaw_account = false

# originam
# [validation.price]
# type = "margin"
# margin = 0.05
#
# # kotili
[validation.price]
type = "fixed"
amount = 20000                                          # 0.02 USDC (6 знаков → 0.02 × 10^6)
token = "4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU"  # devnet USDC mint
strict = false

[metrics]
enabled = true
endpoint = "/metrics"
port = 8080
scrape_interval = 60

[metrics.fee_payer_balance]
enabled = true
expiry_seconds = 30
