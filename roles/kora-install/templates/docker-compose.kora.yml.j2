## {{ ansible_managed }} ##

# Kora relayer — single-service stack.
#
# Supports multiple named instances on the same host.
# Each instance gets its own directory (name provided via role var):
#   /opt/<name>/                 — data (config/, keys/)
#   /opt/docker/<name>/          — compose
#
# Uses host networking — Linux only. Listens on port 8080 by default.
#
# ─── Files needed per instance dir ────────────────────────────────────────────
#   /opt/<name>/config/kora.toml   — managed by role
#   /opt/<name>/keys/signers.toml  — managed by role

services:
  kora:
    image: {{ _image }}:{{ _version }}
    container_name: {{ _name }}
    restart: {{ _restart }}
    network_mode: host
    volumes:
      - {{ _config_path }}/kora.toml:/app/config/kora.toml:ro
      - {{ _keys_path }}:/app/keys:ro
    environment:
      - RUST_LOG={{ _rust_log }}
{% set _default_rpc = 'https://api.mainnet-beta.solana.com' if _mode == 'mainnet' else 'https://api.devnet.solana.com' %}
      - RPC_URL={{ _rpc_url if _rpc_url else _default_rpc }}
      - KORA_PRIVATE_KEY=/app/keys/{{ _key_filename }}
{% if _jupiter_api_key %}
      - JUPITER_API_KEY={{ _jupiter_api_key }}
{% endif %}
    command:
      - "kora"
      - "--config"
      - "/app/config/kora.toml"
      - "rpc"
      - "start"
      - "--port"
      - "{{ _port }}"
      - "--signers-config"
      - "/app/keys/signers.toml"
    logging:
      driver: json-file
      options:
        max-size: 100m
        max-file: '2'
