NOTIXY_LISTEN_ADDR={{ notixy_api_listen_addr | default('127.0.0.1:8080') }}
NOTIXY_DATABASE_URL={{ notixy_api_database_url | default('set_me') }}
NOTIXY_SEND_TOKEN={{ notixy_api_send_token | default('set_me') }}
# Operator token(s) for /v1/admin/deliveries and /v1/admin/reports only (cannot send);
# must differ from every NOTIXY_SEND_TOKEN value. Empty = admin reads disabled.
NOTIXY_OPERATOR_TOKEN={{ notixy_api_operator_token | default('') }}
# sender-api origin (no path) and the token notixy-api presents to its /internal/v1.
NOTIXY_SENDER_API_URL={{ notixy_api_sender_api_url | default('set_me') }}
NOTIXY_SENDER_API_TOKEN={{ notixy_api_sender_api_token | default('set_me') }}
APNS_KEY_ID={{ notixy_api_apns_key_id | default('set_me') }}
APNS_P8={{ notixy_api_apns_p8 | default('set_me') | replace('\n', '\\n') }}
APNS_TEAM_ID={{ notixy_api_apns_team_id | default('set_me') }}
APNS_TOPIC={{ notixy_api_apns_topic | default('set_me') }}
# Public https origin of notixy-api; enables the QR code on the join page (empty = no QR).
NOTIXY_PUBLIC_BASE_URL={{ notixy_api_public_base_url | default('') }}
