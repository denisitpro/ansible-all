## {{ ansible_managed }} ##

# Production-shape compose for rate-hub (rate-api + rate-collector only).
#
# Supports multiple named instances on the same host.
# Each instance gets its own directory (name provided via role var):
#   /opt/<name>/                 — reserved for future instance data (no volumes today)
#   /opt/docker/<name>/          — compose + env files
#
# Valkey/Redis is NOT part of this stack — deploy it with a separate role and set
# VALKEY_ADDR in the env files below.
#
# Both services use host networking — Linux deploy only.
#
# ─── Env ──────────────────────────────────────────────────────────────────────
#   rate-api:       `rate-api.remote.env`
#   rate-collector: `rate-collector.remote.env`
#   Both sit next to this compose file (gitignored `*.env`).
#   Place per-instance env files yourself; the role only manages compose + dirs.
#
#   rate-api.remote.env — set HTTP_ADDR (public API bind, e.g. :8080) and VALKEY_ADDR.
#     Example comment only: VALKEY_ADDR=127.0.0.1:6379
#
#   rate-collector.remote.env — set VALKEY_ADDR and collector/upstream settings.
#     Do not set HTTP_ADDR: collector has no app listen port (metrics port is future work).
#
# ─── Files needed per instance dir ────────────────────────────────────────────
#   docker-compose.yml, rate-api.remote.env, rate-collector.remote.env

services:
  rate-api:
    image: {{ _image }}:{{ _version }}-rate-api
    container_name: {{ _name }}-rate-api
    restart: {{ _restart }}
    network_mode: host
    env_file:
      - rate-api.remote.env

  rate-collector:
    image: {{ _image }}:{{ _version }}-rate-collector
    container_name: {{ _name }}-rate-collector
    restart: {{ _restart }}
    network_mode: host
    env_file:
      - rate-collector.remote.env
