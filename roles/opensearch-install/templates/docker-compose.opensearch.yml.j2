services:
  opensearch:
    image: {{ opensearch_image_name }}
    container_name: opensearch
    network_mode: host
    environment:
      - OPENSEARCH_JAVA_OPTS={{ opensearch_java_opts }}
      - DISABLE_SECURITY_PLUGIN={{ opensearch_disable_security | lower }}
      - DISABLE_INSTALL_DEMO_CONFIG={{ opensearch_disable_security | lower }}
    volumes:
      - {{ opensearch_data_path }}:/usr/share/opensearch/data
      - {{ opensearch_conf_path }}/opensearch.yml:/usr/share/opensearch/config/opensearch.yml
      - {{ opensearch_log_path }}:/usr/share/opensearch/logs
    ulimits:
      memlock:
        soft: -1
        hard: -1
      nofile:
        soft: 65536
        hard: 65536
    restart: {{ opensearch_restart }}
    logging:
      driver: json-file
      options:
        max-size: 100m
        max-file: '2'
