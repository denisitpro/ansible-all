#!/usr/bin/env bash
# Payload prod backup script (B2 -> Wasabi)
# Generated by Ansible - DO NOT EDIT MANUALLY
# Managed by s3-backups role

set -euo pipefail

# Script configuration
SCRIPT_NAME="payload-backup"
LOG_DIR="{{ payload_backup_log_dir }}"
LOG_FILE="${LOG_DIR}/payload-backup-$(date +%Y%m%d-%H%M%S).log"
LOCK_FILE="/tmp/${SCRIPT_NAME}.lock"

# Ensure log directory exists
mkdir -p "${LOG_DIR}"

# Function to log messages
log() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] $*" | tee -a "${LOG_FILE}"
}

# Function to cleanup on exit
cleanup() {
    if [ -f "${LOCK_FILE}" ]; then
        rm -f "${LOCK_FILE}"
    fi
}

trap cleanup EXIT

# Check if another instance is running
if [ -f "${LOCK_FILE}" ]; then
    log "ERROR: Another instance is already running (lock file exists: ${LOCK_FILE})"
    exit 1
fi

# Create lock file
touch "${LOCK_FILE}"

log "=== Starting payload backup (B2 -> Wasabi) ==="

ERRORS=0

log "Copying from {{ payload_backup_config.source.remote }}:{{ payload_backup_config.source.bucket }}"

if rclone copy \
  "{{ payload_backup_config.source.remote }}:{{ payload_backup_config.source.bucket }}" \
  "{{ payload_backup_config.destination.remote }}:{{ payload_backup_config.destination.bucket }}" \
  --max-age "{{ payload_backup_options.max_age }}" \
{% if payload_backup_options.ignore_existing | default(true) %}
  --ignore-existing \
{% endif %}
  --transfers {{ payload_backup_options.transfers }} \
  --checkers {{ payload_backup_options.checkers }} \
{% if payload_backup_options.buffer_size | default('') != '' %}
  --buffer-size "{{ payload_backup_options.buffer_size }}" \
{% endif %}
  --retries {{ payload_backup_options.retries | default(3) }} \
{% if payload_backup_options.fast_list | default(true) %}
  --fast-list \
{% endif %}
{% if payload_backup_options.bwlimit | default('') != '' %}
  --bwlimit "{{ payload_backup_options.bwlimit }}" \
{% endif %}
  --s3-no-check-bucket \
  --log-file "${LOG_FILE}" \
  --log-level {{ payload_backup_log_level }}{% if payload_backup_dry_run | default(true) %} \
  --dry-run{% endif %}; then
    log "SUCCESS: {{ payload_backup_config.source.remote }}:{{ payload_backup_config.source.bucket }} -> {{ payload_backup_config.destination.remote }}:{{ payload_backup_config.destination.bucket }}"
else
    log "ERROR: Failed to copy"
    ERRORS=$((ERRORS + 1))
fi

log "=== Payload backup completed with ${ERRORS} error(s) ==="

if [ ${ERRORS} -gt 0 ]; then
    exit 1
fi

exit 0
