{{ ansible_managed | comment }}

groups:
- name: vault secrets operator alert rules
  rules:
    - alert: VSOVaultLoginError
      expr: |
        sum by (cluster, vault_connection) (
          rate(vso_client_operations_errors_total{
            operation="login",
            cluster!~"{{ excld_cls_vso_vault_login_error | default([]) | join('|') }}"
          }[10m])
        ) > 0
      for: 10m
      labels:
        severity: critical
      annotations:
        summary: "{% raw %}Vault Secrets Operator cannot log in to Vault on {{ $labels.cluster }}{% endraw %}"
        description: "{% raw %}Vault login attempts through connection {{ $labels.vault_connection }} on {{ $labels.cluster }} have been failing for 10 minutes. Every secret managed from this cluster is frozen at its cached value. Usual causes: the Kubernetes auth mount or role no longer exists, the bound service account changed, or the policy attached to the role was revoked.{% endraw %}"

    - alert: VSOResourceInvalid
      expr: |
        controller_resource_status{
          namespace="{{ vso_namespace | default('vault-secrets-operator') }}",
          cluster!~"{{ excld_cls_vso_resource_invalid | default([]) | join('|') }}"
        } == 0
      for: 15m
      labels:
        severity: warning
      annotations:
        summary: "{% raw %}Vault Secrets Operator resource {{ $labels.controller }}/{{ $labels.name }} is invalid on {{ $labels.cluster }}{% endraw %}"
        description: "{% raw %}The {{ $labels.controller }} resource {{ $labels.name }} on {{ $labels.cluster }} has reported an invalid status for 15 minutes. Secrets managed through it are no longer being refreshed. Common cause: the operator cannot authenticate to Vault (auth mount or role missing, policy revoked, token expired).{% endraw %}"

    - alert: VSOResourceInvalidProlonged
      expr: |
        controller_resource_status{
          namespace="{{ vso_namespace | default('vault-secrets-operator') }}",
          cluster!~"{{ excld_cls_vso_resource_invalid | default([]) | join('|') }}"
        } == 0
      for: 2h
      labels:
        severity: critical
      annotations:
        summary: "{% raw %}Vault Secrets Operator resource {{ $labels.controller }}/{{ $labels.name }} invalid for over 2 hours on {{ $labels.cluster }}{% endraw %}"
        description: "{% raw %}The {{ $labels.controller }} resource {{ $labels.name }} on {{ $labels.cluster }} has been invalid for more than 2 hours. Cached secrets will go stale and workloads restarting after this point may come up without credentials.{% endraw %}"

    - alert: VSOReconcileErrors
      expr: |
        sum by (cluster, namespace, controller) (
          increase(controller_runtime_reconcile_errors_total{
            namespace="{{ vso_namespace | default('vault-secrets-operator') }}",
            cluster!~"{{ excld_cls_vso_reconcile_errors | default([]) | join('|') }}"
          }[1h])
        ) > 5
      for: 15m
      labels:
        severity: warning
      annotations:
        summary: "{% raw %}Vault Secrets Operator controller {{ $labels.controller }} is failing to reconcile on {{ $labels.cluster }}{% endraw %}"
        description: "{% raw %}Controller {{ $labels.controller }} in {{ $labels.namespace }} on {{ $labels.cluster }} recorded {{ $value | printf \"%.0f\" }} reconcile errors in the last hour. Check the operator logs for the failing resource.{% endraw %}"

{% for cluster in vso_monitored_clusters | default([]) %}
    - alert: VSOTelemetryAbsent
      expr: absent(vso_build_info{cluster="{{ cluster }}"})
      for: 30m
      labels:
        severity: warning
        cluster: "{{ cluster }}"
      annotations:
        summary: "Vault Secrets Operator on {{ cluster }} is not reporting metrics"
        description: "No vso_build_info series has arrived from {{ cluster }} for 30 minutes. Either the operator is down there, or the metrics path from that cluster is broken. The other VSO alerts are blind to {{ cluster }} while this is firing."

{% endfor %}
