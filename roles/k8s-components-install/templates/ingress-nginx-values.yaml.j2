controller:
  replicaCount: 1 # ignored DaemonSet
  kind: DaemonSet
{% if nginx_ingress_mode == "network_mode" %}
  # hostNetwork mode - direct host network binding (default)
  hostNetwork: true
  dnsPolicy: ClusterFirstWithHostNet
  service:
    enabled: true
    type: ClusterIP
  publishService:
    enabled: false
{% elif nginx_ingress_mode == "node_port" %}
  # NodePort mode - expose via NodePort service
  service:
    type: NodePort
    externalTrafficPolicy: Local
    ports:
      http: 80
      https: 443
    nodePorts:
      http: "{{ nginx_ingress_node_port.http | default('30080') }}"
      https: "{{ nginx_ingress_node_port.https | default('30443') }}"
{% elif nginx_ingress_mode == "host_port" %}
  # hostPort mode - bind to specific host ports via pod spec
  service:
    enabled: true
    type: ClusterIP
  publishService:
    enabled: true
  hostPort:
    enabled: true
    ports:
      http: "{{ nginx_ingress_host_http_port | default('80') }}"
      https: "{{ nginx_ingress_host_https_port | default('443') }}"
{% endif %}
  config:
    proxy-body-size: "{{ nginx_ingress_proxy_body_size | default('500m') }}"
{% if nginx_ingress_worker_shutdown_timeout is defined %}
    # Graceful drain window for old workers after a config reload. TCP stream
    # backends (tcp-services) trigger a full reload on any endpoint change
    # (no Lua dynamic config for stream{}). Set this longer than your
    # longest expected long-lived connection (e.g. DB session via passthrough)
    # so reloads do not abruptly cut active sessions.
    worker-shutdown-timeout: "{{ nginx_ingress_worker_shutdown_timeout }}"
{% endif %}
{% if nginx_ingress_proxy_stream_timeout is defined %}
    # Idle timeout for TCP/UDP stream proxying. Default 600s is too short
    # for long-lived DB connections; align with downstream L4 proxy
    # (e.g. HAProxy `timeout client/server`) to avoid mid-session resets.
    proxy-stream-timeout: "{{ nginx_ingress_proxy_stream_timeout }}"
{% endif %}
{% if nginx_ingress_force_ssl_redirect | default(true) %}
    # Always redirect HTTP -> HTTPS for all ingresses (TLS terminates upstream on Cloudflare).
    # Honors X-Forwarded-Proto via use-forwarded-headers, so HTTPS-from-CF requests are not redirected.
    # Per-ingress opt-out is still possible via nginx.ingress.kubernetes.io/ssl-redirect: "false".
    ssl-redirect: "true"
    force-ssl-redirect: "true"
{% endif %}
{% if nginx_ingress_log_format_json is defined and nginx_ingress_log_format_json %}
    # extend_json_g2 - unified JSON format for ingress-nginx and standalone angie
    log-format-upstream: '{ "timestamp": "$time_iso8601", "remote_addr": "$remote_addr", "host": "$host", "server_name": "$server_name", "request_method": "$request_method", "request_id": "$request_id", "request_uri": "$request_uri", "uri": "$uri", "status": "$status", "body_bytes_sent": "$body_bytes_sent", "bytes_sent": "$bytes_sent", "http_referer": "$http_referer", "http_user_agent": "$http_user_agent", "http_x_forwarded_for": "$http_x_forwarded_for", "request_time": "$request_time", "upstream_addr": "$upstream_addr", "upstream_status": "$upstream_status", "upstream_response_time": "$upstream_response_time", "upstream_connect_time": "$upstream_connect_time", "scheme": "$scheme", "ssl_protocol": "$ssl_protocol", "server_protocol": "$server_protocol", "namespace": "$namespace", "ingress_name": "$ingress_name", "service_name": "$service_name", "service_port": "$service_port", "format": "extend_json_g2" }'
    log-format-escape-json: "true"
{% elif nginx_ingress_log_format_upstream is defined %}
    # Legacy text format (deprecated, use nginx_ingress_log_format_json instead)
    log-format-upstream: '[$time_local] CLIENT: $remote_addr | METHOD: $request_method | HOST: $host | URI: $request_uri | REWRITE_URI: $uri | STATUS: $status | UPSTREAM: $upstream_addr | UP_STATUS: $upstream_status | UP_TIME: ${upstream_response_time}s | REQ_TIME: ${request_time}s | INGRESS: $namespace/$ingress_name | SERVICE: $service_name:$service_port | REQ_ID: $request_id'
{% endif %}
{% if nginx_ingress_real_ip is defined %}
    use-forwarded-headers: "true"
{% if nginx_ingress_allow_snippet_annotations is defined%}
    allow-snippet-annotations: "true"
    annotations-risk-level: "Critical"
{% endif %}    
{% if nginx_ingress_proxy_protocol is defined and nginx_ingress_proxy_protocol %}
    use-proxy-protocol: "true"
    real-ip-header: "proxy_protocol"
{% else %}
    real-ip-header: "CF-Connecting-IP"
{% endif %}
    set-real-ip-from: |
      {{ nginx_ingress_real_ip.ipv4 | join('\n      ') }}
{% if nginx_ingress_real_ip.ipv6 is defined and nginx_ingress_real_ip.ipv6 | length > 0 %}
      {{ nginx_ingress_real_ip.ipv6 | join('\n      ') }}
{% endif %}
    proxy-real-ip-cidr: "{{ (nginx_ingress_real_ip.ipv4 + (nginx_ingress_real_ip.ipv6 | default([]))) | join(',') }}"
{% endif %}
{% if nginx_ingress_use_node_selector is defined and nginx_ingress_use_node_selector %}
  nodeSelector:
{% for key, value in nginx_ingress_node_selector.items() %}
    {{ key }}: {{ value }}
{% endfor %}
{% endif %}
{% if nginx_ingress_tcp_services is defined and nginx_ingress_tcp_services %}
tcp:
{% for port, target in nginx_ingress_tcp_services.items() %}
  {{ port }}: "{{ target }}"
{% endfor %}
{% endif %}
